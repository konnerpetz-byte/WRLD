# Supabase → Project settings → API keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Activity prices (Viator affiliate API). Leave blank to enter prices by hand.
VIATOR_API_KEY=
# Optional: your GetYourGuide affiliate partner ID, added to "More on GetYourGuide" links
GETYOURGUIDE_PARTNER_ID=
# Set to "true" in local development to use sample prices instead (clearly labeled "sample").
PRICING_SAMPLE_DATA=false

# Points wallet (AwardWallet Account Access API, OAuth). Leave blank to hide "Connect".
AWARDWALLET_CLIENT_ID=
AWARDWALLET_CLIENT_SECRET=
AWARDWALLET_AUTHORIZE_URL=

# Your deployed URL (used for sign-in redirects). Production: https://wrldtrips.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Map tiles (default: OpenFreeMap Positron, free, no key)
NEXT_PUBLIC_MAP_STYLE_URL=
# Place search (default: public Photon server; switch before launch)
GEOCODER_URL=
# Street-address fallback (default: public Nominatim, 1 request/second)
NOMINATIM_URL=
# Sent to OpenStreetMap / Wikimedia services; include a contact address before launch
GEOCODER_USER_AGENT=
WIKIMEDIA_USER_AGENT=

# Points flight explorer (/flights). Seats.aero Partner API key, sent as the
# Partner-Authorization header. Commercial use needs Seats.aero's written
# approval (email support@seats.aero). Without a key, PRICING_SAMPLE_DATA=true
# shows labeled sample results.
SEATS_AERO_API_KEY=

# Viator: VIATOR_API_KEY from the partner dashboard. Optional:
# VIATOR_API_BASE=https://api.sandbox.viator.com/partner for a sandbox key,
# VIATOR_PID / VIATOR_MCID (your partner and campaign IDs) to tag search links.
VIATOR_API_BASE=
VIATOR_PID=
VIATOR_MCID=
